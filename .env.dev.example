# Development environment secrets and settings
APP_ENV=dev
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/cloud-etl-dev-deploy
DEPLOY_HEALTH_URL=https://dev.example.com

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=etl_db_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# Data / pipeline
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LOG_DIR=logs
KAGGLE_DOWNLOAD=false
KAGGLE_DATASET=owner/dataset-name
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# AWS / cloud
AWS_ACCESS_KEY_ID=your-dev-access-key
AWS_SECRET_ACCESS_KEY=your-dev-secret-key
AWS_SESSION_TOKEN=

# Deployment / app credentials
GITHUB_TOKEN=ghp_your_token_here
SECRET_KEY=dev-secret-key
