# PostgreSQL Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=etl_db

# Pipeline Configuration
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LOG_DIR=logs
KAGGLE_DOWNLOAD=false
KAGGLE_DATASET=owner/dataset-name
KAGGLE_FORCE_DOWNLOAD=false
KAGGLE_FILE_PATTERN=*.csv
KAGGLE_QUIET=true

# AWS Cloud Configuration
AWS_REGION=us-east-1
AWS_S3_BUCKET=
S3_DATA_PREFIX=data-lake
RAW_S3_PREFIX=raw
PROCESSED_S3_PREFIX=processed
REDSHIFT_HOST=
REDSHIFT_DB=
REDSHIFT_USER=
REDSHIFT_PASSWORD=
REDSHIFT_IAM_ROLE_ARN=
REDSHIFT_SCHEMA=public

# Performance Configuration
CHUNK_SIZE=10000
MAX_RETRIES=3

# Logging
LOG_LEVEL=INFO

# Incremental medallion execution (opt-in)
MEDALLION_PIPELINE_ENABLED=false
MEDALLION_ROOT=data/lake
MEDALLION_FILE_FORMAT=parquet
DATA_QUALITY_CONTRACT_PATH=
METADATA_DATABASE_URL=sqlite:///data/metadata/etl_metadata.db

# Optional contract example: config/contracts/ecommerce_orders.json
# Optional transactional warehouse sink; set DATABASE_URL and a real unique key.
# Example: postgresql+psycopg2://etl_user:replace-me@localhost:5432/etl_db
DATABASE_URL=
TARGET_SCHEMA=raw
TARGET_TABLE=
UPSERT_KEY_COLUMNS=
