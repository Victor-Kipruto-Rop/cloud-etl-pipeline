# Production environment secrets and settings
APP_ENV=production
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/cloud-etl-production-deploy
DEPLOY_HEALTH_URL=https://api.example.com
PRODUCTION_HEALTH_URL=https://api.example.com

# Database
POSTGRES_HOST=prod-db.internal
POSTGRES_PORT=5432
POSTGRES_DB=etl_db_production
POSTGRES_USER=etl_app
POSTGRES_PASSWORD=replace-with-managed-secret

# Data / pipeline
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LOG_DIR=logs
KAGGLE_DOWNLOAD=false
KAGGLE_DATASET=owner/dataset-name
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# AWS / cloud
AWS_ACCESS_KEY_ID=your-production-access-key
AWS_SECRET_ACCESS_KEY=your-production-secret-key
AWS_SESSION_TOKEN=

# Deployment / app credentials
GITHUB_TOKEN=ghp_your_token_here
SECRET_KEY=production-secret-key
ROLLBACK_TARGET_TAG=last-known-good-release
PREVIOUS_RELEASE_TAG=last-known-good-release
