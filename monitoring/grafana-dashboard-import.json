{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "#000000",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "#73BF69",
        "name": "Deployments",
        "expr": "increase(etl_files_processed_total[5m]) > 0 or on() vector(0)",
        "titleFormat": "Deploy",
        "textFormat": "Release deployment started"
      },
      {
        "datasource": "Prometheus",
        "enable": true,
        "iconColor": "#F2495C",
        "name": "Rollbacks",
        "expr": "increase(etl_job_failures_total[10m]) > 0 or on() vector(0)",
        "titleFormat": "Rollback",
        "textFormat": "Rollback or incident response started"
      }
    ]
  },
  "title": "ETL Pipeline Overview",
  "panels": [
    {
      "id": 1,
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "type": "stat",
      "title": "Files Processed",
      "targets": [{"expr": "increase(etl_files_processed_total[1h])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}}
    },
    {
      "id": 2,
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "type": "stat",
      "title": "Files Failed (1h)",
      "targets": [{"expr": "increase(etl_files_failed_total[1h])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}}
    },
    {
      "id": 3,
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "type": "stat",
      "title": "Current Files In Progress",
      "targets": [{"expr": "etl_current_in_progress", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "none"}}
    },
    {
      "id": 4,
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "type": "graph",
      "title": "Rows Loaded /s",
      "targets": [{"expr": "rate(etl_rows_loaded_total[1m])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops/s"}}
    },
    {
      "id": 5,
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "type": "graph",
      "title": "Rows Extracted /s",
      "targets": [{"expr": "rate(etl_rows_extracted_total[1m])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "ops/s"}}
    },
    {
      "id": 6,
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 14},
      "type": "graph",
      "title": "Failure Rate /m",
      "targets": [{"expr": "rate(etl_files_failed_total[5m])", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "1/min"}}
    },
    {
      "id": 7,
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 14},
      "type": "stat",
      "title": "SLO: Success Rate (7d)",
      "targets": [{"expr": "100 * (1 - increase(etl_files_failed_total[7d]) / increase(etl_files_processed_total[7d]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 99}, {"color": "green", "value": 99.0}]}}}
    },
    {
      "id": 8,
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 14},
      "type": "gauge",
      "title": "SLO: Error Budget Remaining (%)",
      "targets": [{"expr": "((1 - increase(etl_files_failed_total[7d]) / increase(etl_files_processed_total[7d])) - 0.99) / 0.01 * 100", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "yellow", "value": 20}, {"color": "green", "value": 50}]}}}
    },
    {
      "id": 9,
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 20},
      "type": "stat",
      "title": "Freshness: Max Age (min)",
      "targets": [{"expr": "(time() - max(etl_last_successful_run_timestamp_seconds)) / 60", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "minutes", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 60}, {"color": "red", "value": 240}]}}}
    },
    {
      "id": 10,
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 20},
      "type": "graph",
      "title": "Freshness by Source (min)",
      "targets": [{"expr": "(time() - etl_last_successful_run_timestamp_seconds) / 60", "legendFormat": "{{source}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "minutes"}}
    },
    {
      "id": 11,
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 28},
      "type": "graph",
      "title": "Latency p95 (5m)",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(etl_pipeline_latency_seconds_bucket[5m])) by (le))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 12,
      "gridPos": {"h": 6, "w": 12, "x": 12, "y": 28},
      "type": "graph",
      "title": "Latency p99 (5m)",
      "targets": [{"expr": "histogram_quantile(0.99, sum(rate(etl_pipeline_latency_seconds_bucket[5m])) by (le))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}}
    },
    {
      "id": 13,
      "gridPos": {"h": 6, "w": 24, "x": 0, "y": 34},
      "type": "graph",
      "title": "SLO Compliance (30d)",
      "targets": [{"expr": "100 * (1 - increase(etl_files_failed_total[30d]) / increase(etl_files_processed_total[30d]))", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    }
  ],
  "schemaVersion": 16,
  "version": 1
}
