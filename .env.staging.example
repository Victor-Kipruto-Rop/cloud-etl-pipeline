# Staging environment secrets and settings
APP_ENV=staging
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ROLE_TO_ASSUME=arn:aws:iam::123456789012:role/cloud-etl-staging-deploy
DEPLOY_HEALTH_URL=https://staging.example.com

# Database
POSTGRES_HOST=staging-db.internal
POSTGRES_PORT=5432
POSTGRES_DB=etl_db_staging
POSTGRES_USER=etl_app
POSTGRES_PASSWORD=change-me

# Data / pipeline
RAW_DATA_DIR=data/raw
PROCESSED_DATA_DIR=data/processed
LOG_DIR=logs
KAGGLE_DOWNLOAD=false
KAGGLE_DATASET=owner/dataset-name
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_KEY=your-kaggle-api-key

# AWS / cloud
AWS_ACCESS_KEY_ID=your-staging-access-key
AWS_SECRET_ACCESS_KEY=your-staging-secret-key
AWS_SESSION_TOKEN=

# Deployment / app credentials
GITHUB_TOKEN=ghp_your_token_here
SECRET_KEY=staging-secret-key
